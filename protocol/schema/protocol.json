{
  "version": 2,
  "$comment": "Single source of truth for the core<->shell contract. Both languages are GENERATED from this file; neither is written by hand. See the protocol spec §2.4 and §2.5.",
  "$privileged": "A command may carry Bytes only behind `privileged: true` (§2.4). The value comes from a native dialog owned by the shell; the renderer may never originate a path or an executable and must never call one of these directly.",
  "$idempotent": "`idempotent: false` marks the operations §2.2 forbids auto-replaying: a launch, a session mutation, a flag change. On core death these are rejected with `outcome: \"unknown\"` and surfaced to the user.",
  "errors": [
    "CORE_RESTARTED",
    "GIT_MISSING",
    "GIT_TOO_OLD",
    "REPO_UNREADABLE",
    "PERMISSION_DENIED",
    "PATH_GONE",
    "STORE_OFFLINE",
    "BUDGET_EXCEEDED",
    "UNTRUSTED_REPO",
    "PROJECT_MERGED",
    "PROTOCOL",
    "INTERNAL"
  ],
  "types": {
    "ProjectId": { "kind": "id", "repr": "i64" },
    "LocationId": { "kind": "id", "repr": "i64" },
    "RootId": { "kind": "id", "repr": "i64" },
    "TargetId": { "kind": "id", "repr": "i64" },
    "SessionId": { "kind": "id", "repr": "i64" },
    "ScanRunId": { "kind": "id", "repr": "i64" },
    "Empty": { "kind": "struct", "fields": {} },
    "LocationRef": {
      "kind": "struct",
      "fields": { "id": "LocationId", "pathDisplay": "String" }
    },

    "Outcome": { "kind": "enum", "variants": ["unknown"] },
    "Hello": {
      "kind": "struct",
      "fields": { "protocolVersion": "u32", "coreVersion": "String", "epoch": "u32" }
    },
    "ErrorFrame": {
      "kind": "struct",
      "fields": {
        "code": "ErrorCode",
        "message": "String",
        "retryable": "bool",
        "outcome": "Outcome?"
      }
    },

    "LocationKind": { "kind": "enum", "variants": ["win", "linux", "wsl"] },

    "RootProvenance": {
      "kind": "enum",
      "variants": [
        "gitconfig",
        "editor_recent",
        "convention",
        "cloud_synced",
        "system_root",
        "distro",
        "dialog"
      ]
    },
    "RootState": { "kind": "enum", "variants": ["watched", "ignored", "offline"] },
    "RootRefusal": {
      "kind": "enum",
      "variants": [
        "filesystem_root",
        "home_without_narrowing",
        "too_many_directories",
        "already_a_root"
      ]
    },
    "RootSuggestion": {
      "kind": "struct",
      "fields": {
        "pathDisplay": "String",
        "kind": "LocationKind",
        "distro": "String",
        "provenance": "RootProvenance",
        "provenanceDetail": "String?",
        "hits": "u32?",
        "preTicked": "bool"
      }
    },
    "Root": {
      "kind": "struct",
      "fields": {
        "id": "RootId",
        "pathDisplay": "String",
        "kind": "LocationKind",
        "distro": "String",
        "enabled": "bool",
        "descendIntoRepos": "bool",
        "provenance": "RootProvenance",
        "state": "RootState",
        "addedAt": "Timestamp",
        "projectCount": "u32?"
      }
    },
    "RootAdd": {
      "kind": "struct",
      "fields": { "root": "Root?", "refusedBecause": "RootRefusal?", "estimatedDirs": "i64?" }
    },

    "ScanMode": { "kind": "enum", "variants": ["full", "incremental"] },
    "ScanStatus": {
      "kind": "struct",
      "fields": {
        "runId": "ScanRunId?",
        "running": "bool",
        "generation": "u32?",
        "mode": "ScanMode?",
        "startedAt": "Timestamp?",
        "endedAt": "Timestamp?",
        "cancelled": "bool",
        "walkedDirs": "i64",
        "foundRepos": "u32",
        "indexedProjects": "u32",
        "problemCount": "u32?",
        "ambiguousLineageCount": "u32?"
      }
    },

    "ProblemKind": {
      "kind": "enum",
      "variants": [
        "permission_denied",
        "untrusted_repo",
        "unreadable_repo",
        "deferred_slow",
        "clock_skew",
        "non_utf8_path",
        "offline_store",
        "ambiguous_lineage"
      ]
    },
    "ProblemItem": {
      "kind": "struct",
      "fields": {
        "pathDisplay": "String",
        "detail": "String?",
        "count": "u32",
        "projectId": "ProjectId?",
        "locationId": "LocationId?",
        "lastSeenAt": "Timestamp?",
        "candidateProjectIds": "[ProjectId]"
      }
    },
    "ProblemGroup": {
      "kind": "struct",
      "fields": { "kind": "ProblemKind", "count": "u32", "items": "[ProblemItem]" }
    },
    "ProblemHeader": {
      "kind": "struct",
      "fields": {
        "walkedDirs": "i64",
        "repositories": "u32",
        "problemCount": "u32?",
        "ambiguousLineageCount": "u32?"
      }
    },
    "Problems": {
      "kind": "struct",
      "fields": { "runId": "ScanRunId?", "header": "ProblemHeader", "groups": "[ProblemGroup]" }
    },

    "SortKey": { "kind": "enum", "variants": ["last_touched", "name", "size"] },
    "ViewMode": { "kind": "enum", "variants": ["grid", "list"] },
    "WindowGeometry": {
      "kind": "struct",
      "fields": {
        "x": "i32",
        "y": "i32",
        "width": "u32",
        "height": "u32",
        "maximized": "bool",
        "monitorId": "String?"
      }
    },
    "ViewState": {
      "kind": "struct",
      "fields": {
        "query": "String",
        "sort": "SortKey",
        "viewMode": "ViewMode",
        "density": "u32",
        "collapsedSections": "[String]",
        "scrollOffset": "f64",
        "selectedProjectId": "ProjectId?",
        "dismissedNotices": "[String]",
        "windowGeometry": "WindowGeometry?",
        "savedAt": "Timestamp?"
      },
      "$comment": "§8: `savedAt` is null on a fresh install and non-null on a restored view, which is the only thing separating the two — every other field reads identically when a client deliberately saves an empty shelf, so without it a first run and a cleared shelf are indistinguishable on the wire. It is deliberately NOT on ViewPatch: the core stamps it inside view.set, so a client cannot forge a provenance it does not have"
    },
    "ViewPatch": {
      "kind": "struct",
      "fields": {
        "query": "String?",
        "sort": "SortKey?",
        "viewMode": "ViewMode?",
        "density": "u32?",
        "collapsedSections": "[String]?",
        "scrollOffset": "f64?",
        "selectedProjectId": "ProjectId?",
        "dismissedNotices": "[String]?",
        "windowGeometry": "WindowGeometry?"
      }
    },

    "EffectsTier": { "kind": "enum", "variants": ["auto", "full", "reduced", "off"] },
    "LogLevel": { "kind": "enum", "variants": ["error", "warn", "info", "debug", "trace"] },
    "Settings": {
      "kind": "struct",
      "fields": {
        "effectsTier": "EffectsTier",
        "reducedMotionOverride": "bool",
        "autostart": "bool",
        "residentShortcut": "String?",
        "roastEnabled": "bool",
        "logLevel": "LogLevel"
      }
    },
    "SettingsPatch": {
      "kind": "struct",
      "fields": {
        "effectsTier": "EffectsTier?",
        "reducedMotionOverride": "bool?",
        "autostart": "bool?",
        "residentShortcut": "String?",
        "roastEnabled": "bool?",
        "logLevel": "LogLevel?"
      }
    },

    "DiagBundle": {
      "kind": "struct",
      "fields": {
        "pathBytes": "Bytes",
        "pathDisplay": "String",
        "sizeBytes": "i64",
        "anonymised": "bool"
      }
    },

    "CollectionId": { "kind": "id", "repr": "i64" },
    "SceneHash": { "kind": "id", "repr": "String" },

    "Presence": { "kind": "enum", "variants": ["present", "offline", "missing", "unscanned"] },
    "ConditionSignal": {
      "kind": "enum",
      "variants": ["live", "idle", "dormant", "neglected", "abandoned", "offline", "empty"]
    },
    "ArtState": { "kind": "enum", "variants": ["pending", "ready", "failed", "stale"] },
    "DescriptionSource": {
      "kind": "enum",
      "variants": ["manifest", "readme", "note", "detected"]
    },
    "InterruptedOp": {
      "kind": "enum",
      "variants": ["merge", "rebase", "cherry_pick", "revert", "bisect", "am"]
    },
    "HeadComparison": {
      "kind": "enum",
      "variants": ["same_commit", "different_commit", "not_compared"]
    },
    "AssociationKind": {
      "kind": "enum",
      "variants": ["definitive", "strong", "inferred", "manual"]
    },
    "Flag": { "kind": "enum", "variants": ["pinned", "archived", "hidden"] },
    "ReadmeStateKind": { "kind": "enum", "variants": ["not_indexed", "absent", "present"] },
    "ReadmeState": {
      "kind": "struct",
      "fields": { "state": "ReadmeStateKind", "text": "String?", "readAt": "Timestamp?" }
    },
    "LaneState": {
      "kind": "enum",
      "variants": ["measured", "not_computed", "shallow_excluded"]
    },

    "TargetKind": { "kind": "enum", "variants": ["editor", "terminal", "file_manager", "git_client"] },
    "VerifyState": { "kind": "enum", "variants": ["unverified", "ok", "missing", "not_executable"] },
    "CwdMode": { "kind": "enum", "variants": ["location", "none"] },
    "TargetTier": {
      "kind": "enum",
      "variants": ["project", "location", "language", "global"]
    },
    "TargetRow": {
      "kind": "struct",
      "fields": {
        "id": "TargetId",
        "kind": "TargetKind",
        "name": "String",
        "projectId": "ProjectId?",
        "locationId": "LocationId?",
        "language": "String?",
        "sortIndex": "u32",
        "detected": "bool",
        "verifyState": "VerifyState",
        "verifiedAt": "Timestamp?",
        "execDisplay": "String"
      }
    },
    "ResolvedTarget": {
      "kind": "struct",
      "fields": { "target": "TargetRow", "tier": "TargetTier" }
    },

    "CloseReason": {
      "kind": "enum",
      "variants": ["stop", "idle", "process_exit", "app_exit", "crash", "orphaned"]
    },
    "ClosedBy": {
      "kind": "enum",
      "variants": ["idle", "session_end", "app_exit", "crash"],
      "$comment": "§9: a segment closes for a narrower set of reasons than a session does. 'stop', 'process_exit' and 'orphaned' end a session; the segment open at that moment closes as 'session_end'. Not a duplicate of CloseReason — do not collapse them"
    },
    "SessionRef": {
      "kind": "struct",
      "fields": {
        "id": "SessionId",
        "projectId": "ProjectId",
        "locationId": "LocationId",
        "targetId": "TargetId",
        "startedAt": "Timestamp",
        "endedAt": "Timestamp?",
        "creditedSeconds": "i64",
        "closeReason": "CloseReason?"
      }
    },

    "CommitRef": {
      "kind": "struct",
      "fields": {
        "sha": "String",
        "subject": "String",
        "at": "Timestamp",
        "tzOffsetMin": "i32"
      }
    },
    "WorktreeObservation": {
      "kind": "struct",
      "fields": { "observedAt": "Timestamp?", "isDirty": "bool?", "untrackedCount": "u32?" }
    },

    "ProjectRow": {
      "kind": "struct",
      "fields": {
        "id": "ProjectId",
        "name": "String",
        "owner": "String?",
        "description": "String?",
        "descriptionSource": "DescriptionSource?",
        "birthYear": "u32?",
        "primaryLanguage": "String?",
        "archetype": "String?",
        "seedBasename": "String",
        "rerollOffset": "u32",
        "artSceneHash": "SceneHash?",
        "artState": "ArtState",
        "conditionSignal": "ConditionSignal?",
        "completionLit": "u32?",
        "completionApplicable": "u32?",
        "isPinned": "bool",
        "isArchived": "bool",
        "isHidden": "bool",
        "isReference": "bool",
        "isFork": "bool",
        "isBare": "bool",
        "isShallow": "bool",
        "isSubmodule": "bool",
        "ambiguousLineage": "bool",
        "lastTouchedAt": "Timestamp",
        "lastInteractionAt": "Timestamp?",
        "lastCommitAt": "Timestamp?",
        "lastCommitSubject": "String?",
        "firstCommitAt": "Timestamp?",
        "createdAt": "Timestamp",
        "acknowledgedAt": "Timestamp?",
        "sizeTrackedBytes": "i64?",
        "trackedFiles": "i64?",
        "collectionIds": "[CollectionId]",
        "primaryLocation": "LocationRef?",
        "presence": "Presence",
        "branch": "String?",
        "isDirty": "bool?",
        "untrackedCount": "u32?",
        "ahead": "u32?",
        "behind": "u32?",
        "stashCount": "u32?",
        "interruptedOp": "InterruptedOp?",
        "fetchHeadAt": "Timestamp?",
        "refstateObservedAt": "Timestamp?",
        "worktreeObservedAt": "Timestamp?",
        "errorKind": "ErrorCode?",
        "errorAt": "Timestamp?",
        "eraSectionId": "String"
      }
    },

    "EraAggregate": {
      "kind": "struct",
      "fields": {
        "trackedBytes": "i64",
        "indexedCount": "u32",
        "unpushed": "u32",
        "uncommitted": "u32",
        "interrupted": "u32",
        "unchecked": "u32"
      }
    },
    "EraSection": {
      "kind": "struct",
      "fields": {
        "id": "String",
        "order": "u32",
        "year": "u32?",
        "cutAgainstYear": "u32",
        "count": "u32",
        "agg": "EraAggregate"
      }
    },
    "Window": { "kind": "struct", "fields": { "from": "u32", "to": "u32" } },
    "ProjectPage": {
      "kind": "struct",
      "fields": {
        "sections": "[EraSection]",
        "rows": "[ProjectRow]",
        "window": "Window",
        "orderKey": "String",
        "generation": "u32"
      }
    },

    "LocationDetail": {
      "kind": "struct",
      "fields": {
        "location": "LocationRef",
        "kind": "LocationKind",
        "distro": "String",
        "presence": "Presence",
        "isPrimary": "bool",
        "branch": "String?",
        "headOid": "String?",
        "headComparison": "HeadComparison",
        "ahead": "u32?",
        "behind": "u32?",
        "isDirty": "bool?",
        "untrackedCount": "u32?",
        "stashCount": "u32?",
        "interruptedOp": "InterruptedOp?",
        "lastSeenAt": "Timestamp?",
        "refstateObservedAt": "Timestamp?",
        "worktreeObservedAt": "Timestamp?",
        "fetchHeadAt": "Timestamp?",
        "trustedAt": "Timestamp?",
        "coveringRootId": "RootId?"
      }
    },

    "ActivityWeek": {
      "kind": "struct",
      "fields": {
        "weekStart": "Timestamp",
        "commitDays": "u32?",
        "sessionCount": "u32?",
        "sessionSeconds": "i64?"
      }
    },
    "Activity": {
      "kind": "struct",
      "fields": { "weeks": "[ActivityWeek]", "commitDays": "LaneState", "sessions": "LaneState" }
    },

    "ProjectDetail": {
      "kind": "struct",
      "fields": {
        "row": "ProjectRow",
        "locations": "[LocationDetail]",
        "resolvedTarget": "ResolvedTarget?",
        "targets": "[TargetRow]",
        "readme": "ReadmeState",
        "notes": "String?",
        "remoteKey": "String?",
        "lineageKey": "String?",
        "associationKind": "AssociationKind?",
        "seedBasename": "String",
        "rerollOffset": "u32",
        "playtimeSeconds": "i64",
        "liveSession": "SessionRef?",
        "activity": "Activity",
        "recentCommits": "[CommitRef]",
        "firstCommitSha": "String?",
        "firstCommitTzOffsetMin": "i32?",
        "sizeWorktreeBytes": "i64?"
      }
    },

    "Peek": {
      "kind": "struct",
      "fields": {
        "id": "ProjectId",
        "readme": "ReadmeState",
        "commits": "[CommitRef]",
        "location": "LocationRef?",
        "worktree": "WorktreeObservation",
        "birthYear": "u32?",
        "primaryLanguage": "String?",
        "sizeTrackedBytes": "i64?",
        "lastCommitAt": "Timestamp?",
        "playtimeSeconds": "i64",
        "interruptedOp": "InterruptedOp?"
      }
    },

    "MergeResult": {
      "kind": "struct",
      "fields": {
        "survivor": "ProjectId",
        "absorbed": "ProjectId",
        "locationsReparented": "u32",
        "sessionsReparented": "u32",
        "collectionMembersMerged": "u32",
        "xpEventsRecomputed": "u32"
      }
    },
    "UnmergeHint": {
      "kind": "struct",
      "fields": {
        "absorbedProjectId": "ProjectId",
        "associationKind": "AssociationKind",
        "mergedAt": "Timestamp",
        "locations": "u32",
        "sessions": "u32",
        "collectionMemberships": "u32",
        "xpEvents": "u32",
        "notesConcatenated": "bool",
        "flagsOrred": "[Flag]",
        "flagsAnded": "[Flag]"
      }
    },
    "RequeueResult": { "kind": "struct", "fields": { "jobsRequeued": "u32" } },

    "IdentityId": { "kind": "id", "repr": "i64" },

    "TargetList": {
      "kind": "struct",
      "fields": { "resolved": "ResolvedTarget?", "rows": "[TargetRow]" }
    },
    "TargetVerification": {
      "kind": "struct",
      "fields": {
        "targetId": "TargetId",
        "verifyState": "VerifyState",
        "verifiedAt": "Timestamp",
        "execDisplay": "String"
      }
    },

    "Rendition": { "kind": "enum", "variants": ["card", "hero"] },
    "ArtRerender": {
      "kind": "struct",
      "fields": {
        "projectId": "ProjectId",
        "offset": "u32",
        "rejected": "bool",
        "sceneHash": "SceneHash?",
        "artState": "ArtState"
      }
    },

    "IdentitySource": {
      "kind": "enum",
      "variants": ["gitconfig", "noreply", "inferred", "manual"]
    },
    "AliasReason": { "kind": "enum", "variants": ["local_part", "coauthor", "manual"] },
    "IdentityRow": {
      "kind": "struct",
      "fields": {
        "id": "IdentityId",
        "email": "String",
        "name": "String?",
        "isUser": "bool",
        "source": "IdentitySource",
        "aliasReason": "AliasReason?",
        "primaryEmail": "String?",
        "repositories": "u32?",
        "commits": "i64",
        "projects": "u32",
        "confirmedAt": "Timestamp?"
      }
    },
    "IdentityConfirm": {
      "kind": "struct",
      "fields": { "movedToReference": "u32", "commitDaysRemoved": "i64", "applied": "bool" }
    },

    "RevealBasis": {
      "kind": "struct",
      "fields": {
        "projectsCovered": "u32",
        "projectsTotal": "u32",
        "historyComplete": "bool"
      }
    },
    "RevealFigure": { "kind": "struct", "fields": { "value": "f64?", "basis": "RevealBasis" } },
    "RevealOldest": {
      "kind": "struct",
      "fields": {
        "projectId": "ProjectId?",
        "firstCommitAt": "Timestamp?",
        "basis": "RevealBasis"
      }
    },
    "Reveal": {
      "kind": "struct",
      "fields": {
        "spanDays": "RevealFigure",
        "projectCount": "RevealFigure",
        "languageCount": "RevealFigure",
        "bestYear": "RevealFigure",
        "playtimeSeconds": "RevealFigure",
        "oldestStillAlive": "RevealOldest"
      }
    },

    "CollectionKind": { "kind": "enum", "variants": ["manual", "query"] },
    "CollectionRefusal": {
      "kind": "enum",
      "variants": [
        "empty_name",
        "name_taken",
        "too_long",
        "contains_collection_term",
        "limit_reached"
      ]
    },
    "Collection": {
      "kind": "struct",
      "fields": {
        "id": "CollectionId",
        "name": "String",
        "kind": "CollectionKind",
        "queryText": "String?",
        "queryGrammarVersion": "u32",
        "sortIndex": "u32",
        "memberCount": "u32?"
      }
    },
    "CollectionUpsert": {
      "kind": "struct",
      "fields": { "collection": "Collection?", "refusedBecause": "CollectionRefusal?" }
    },

    "Job": { "kind": "enum", "variants": ["j0", "j1", "j1_5", "j2", "j3", "j4", "j5", "j6"] },
    "DegradedReason": {
      "kind": "enum",
      "variants": [
        "git_missing",
        "git_too_old",
        "store_offline",
        "budget_exceeded",
        "index_read_only"
      ]
    },

    "ScanRunStarted": {
      "kind": "struct",
      "fields": {
        "runId": "ScanRunId",
        "generation": "u32",
        "mode": "ScanMode",
        "roots": "[RootId]",
        "startedAt": "Timestamp"
      }
    },
    "RepoFound": {
      "kind": "struct",
      "fields": {
        "runId": "ScanRunId",
        "projectId": "ProjectId",
        "location": "LocationRef",
        "isNew": "bool"
      }
    },
    "JobDone": {
      "kind": "struct",
      "fields": {
        "runId": "ScanRunId",
        "projectId": "ProjectId",
        "job": "Job",
        "ok": "bool",
        "elapsedMs": "u32",
        "deferred": "bool"
      }
    },
    "ScanProgress": {
      "kind": "struct",
      "fields": {
        "runId": "ScanRunId",
        "walkedDirs": "i64",
        "foundRepos": "u32",
        "indexedProjects": "u32"
      }
    },
    "ProblemFound": {
      "kind": "struct",
      "fields": {
        "runId": "ScanRunId",
        "kind": "ProblemKind",
        "pathDisplay": "String",
        "detail": "String?"
      }
    },
    "ScanFinished": {
      "kind": "struct",
      "fields": {
        "runId": "ScanRunId",
        "endedAt": "Timestamp",
        "walkedDirs": "i64",
        "foundRepos": "u32",
        "problemCount": "u32",
        "ambiguousLineageCount": "u32"
      }
    },
    "ScanCancelled": {
      "kind": "struct",
      "fields": { "runId": "ScanRunId", "endedAt": "Timestamp", "indexedProjects": "u32" }
    },

    "ProjectUpserted": { "kind": "struct", "fields": { "row": "ProjectRow" } },
    "ProjectMerged": { "kind": "struct", "fields": { "from": "ProjectId", "into": "ProjectId" } },
    "ProjectFlagsChanged": {
      "kind": "struct",
      "fields": {
        "id": "ProjectId",
        "isPinned": "bool",
        "isArchived": "bool",
        "isHidden": "bool"
      }
    },
    "ProjectConditionChanged": {
      "kind": "struct",
      "fields": { "id": "ProjectId", "conditionSignal": "ConditionSignal?" }
    },
    "ArtReady": {
      "kind": "struct",
      "fields": {
        "projectId": "ProjectId",
        "sceneHash": "SceneHash",
        "rendition": "Rendition",
        "artState": "ArtState"
      }
    },
    "ProjectsSnapshot": {
      "kind": "struct",
      "fields": {
        "epoch": "u32",
        "throughSeq": "i64",
        "generation": "u32",
        "rows": "[ProjectRow]"
      }
    },

    "SessionStarted": { "kind": "struct", "fields": { "session": "SessionRef" } },
    "SegmentClosed": {
      "kind": "struct",
      "fields": {
        "sessionId": "SessionId",
        "projectId": "ProjectId",
        "startedAt": "Timestamp",
        "endedAt": "Timestamp",
        "creditedSeconds": "i64",
        "closedBy": "ClosedBy",
        "sessionCreditedSeconds": "i64"
      }
    },
    "SessionEnded": { "kind": "struct", "fields": { "session": "SessionRef" } },

    "CoreError": {
      "kind": "struct",
      "fields": { "code": "ErrorCode", "message": "String", "projectId": "ProjectId?" }
    },
    "CoreDegraded": {
      "kind": "struct",
      "fields": { "reason": "DegradedReason", "detail": "String?" }
    },
    "CoreSnapshot": {
      "kind": "struct",
      "fields": {
        "epoch": "u32",
        "throughSeq": "i64",
        "gitVersion": "String?",
        "schemaVersion": "u32",
        "scan": "ScanStatus"
      }
    },

    "LedgerCounts": {
      "kind": "struct",
      "fields": {
        "projects": "i64?",
        "notes": "i64?",
        "sessions": "i64?",
        "sessionSegments": "i64?",
        "collections": "i64?",
        "collectionMembers": "i64?",
        "roots": "i64?",
        "identities": "i64?",
        "aliases": "i64?",
        "merges": "i64?",
        "settings": "i64?",
        "viewState": "i64?",
        "xpEvents": "i64?",
        "launchTargets": "i64?"
      }
    },
    "CorruptIndexLedger": {
      "kind": "struct",
      "fields": {
        "quarantinedAt": "Timestamp",
        "gapStartedAt": "Timestamp?",
        "gapCountsRecoverable": "bool",
        "reDerivable": "LedgerCounts",
        "restorable": "LedgerCounts",
        "deferred": "LedgerCounts"
      }
    }
  },
  "commands": [
    { "name": "app.hello_ack", "args": { "protocolVersion": "u32" }, "returns": "Empty" },
    { "name": "app.shutdown", "args": {}, "returns": "Empty" },
    { "name": "roots.suggest", "args": {}, "returns": "[RootSuggestion]" },
    {
      "name": "roots.list",
      "args": {},
      "returns": "[Root]",
      "$comment": "§11.3a draws a row per root and an `N OF M ACTIVE` caption; §2.4's table declared only the mutations, so nothing returned the set. Read-only and unprivileged: no path crosses in either direction, only RootId and path_display. Plan 16 implements the handler"
    },
    {
      "name": "roots.add",
      "args": { "pathBytes": "Bytes", "confirmLarge": "bool" },
      "returns": "RootAdd",
      "privileged": true,
      "$comment": "privileged: the path originates from a shell-owned native dialog, never from the renderer. §10.1a's refuse-list answers with RootRefusal and an explanation, never a silent no"
    },
    { "name": "roots.remove", "args": { "id": "RootId" }, "returns": "Empty" },
    {
      "name": "roots.setEnabled",
      "args": { "id": "RootId", "enabled": "bool" },
      "returns": "Empty"
    },
    {
      "name": "roots.setDescend",
      "args": { "id": "RootId", "descendIntoRepos": "bool" },
      "returns": "Empty"
    },
    { "name": "scan.start", "args": { "full": "bool" }, "returns": "ScanRunId" },
    { "name": "scan.cancel", "args": { "id": "ScanRunId" }, "returns": "Empty" },
    { "name": "scan.status", "args": {}, "returns": "ScanStatus" },
    { "name": "problems.list", "args": { "run": "ScanRunId?" }, "returns": "Problems" },
    { "name": "settings.get", "args": {}, "returns": "Settings" },
    { "name": "settings.set", "args": { "patch": "SettingsPatch" }, "returns": "Settings" },
    { "name": "view.get", "args": {}, "returns": "ViewState" },
    { "name": "view.set", "args": { "patch": "ViewPatch" }, "returns": "Empty" },
    { "name": "diag.bundle", "args": { "includeRealPaths": "bool" }, "returns": "DiagBundle" },
    {
      "name": "projects.list",
      "args": { "query": "String?", "sort": "SortKey?", "window": "Window?" },
      "returns": "ProjectPage",
      "$comment": "§8.2: every field is optional with a stated default, because the projects topic's snapshot calls this with {}. `window` is the same shape the response carries, so a caller pages by echoing back the window it was given rather than by rebuilding from/to"
    },
    { "name": "projects.get", "args": { "id": "ProjectId" }, "returns": "ProjectDetail" },
    { "name": "projects.peek", "args": { "id": "ProjectId" }, "returns": "Peek" },
    {
      "name": "projects.setFlags",
      "args": {
        "id": "ProjectId",
        "isPinned": "bool?",
        "isArchived": "bool?",
        "isHidden": "bool?"
      },
      "returns": "Empty",
      "idempotent": false,
      "$comment": "§2.2: a flag change is non-idempotent and is never auto-replayed. null leaves a flag unchanged"
    },
    {
      "name": "projects.setNote",
      "args": { "id": "ProjectId", "note": "String?" },
      "returns": "Empty"
    },
    {
      "name": "projects.merge",
      "args": { "from": "ProjectId", "into": "ProjectId" },
      "returns": "MergeResult",
      "$comment": "§11.1: ships with no phase-1 caller and zero call sites outside the test suite"
    },
    {
      "name": "projects.unmergeHint",
      "args": { "id": "ProjectId" },
      "returns": "[UnmergeHint]",
      "$comment": "§1.5: a read-only advisory. It reports what a split would have to decide and decides nothing"
    },
    {
      "name": "projects.requeue",
      "args": { "id": "ProjectId" },
      "returns": "RequeueResult",
      "$comment": "§11.1: re-queues exactly one project's failed and deferred project_job_state rows. TRY AGAIN on one tile means one repository, so this is not scan.start"
    },
    {
      "name": "projects.launch",
      "args": { "projectId": "ProjectId", "locationId": "LocationId", "targetId": "TargetId" },
      "returns": "SessionId",
      "idempotent": false
    },
    {
      "name": "locations.setTrusted",
      "args": { "locationId": "LocationId" },
      "returns": "Empty",
      "$comment": "§1.3/§3.2: writes location.trusted_at in Codotheca's own database, never the user's git config. The -c safe.directory argument is assembled core-side, so no path crosses the wire in either direction"
    },
    {
      "name": "locations.relocate",
      "args": { "locationId": "LocationId", "pathBytes": "Bytes" },
      "returns": "LocationDetail",
      "privileged": true,
      "$comment": "§17: rewrites path_bytes in place and keeps scan_generation. It is the only phase-1 write to a location's path"
    },
    {
      "name": "targets.list",
      "args": { "projectId": "ProjectId?", "locationId": "LocationId?" },
      "returns": "TargetList"
    },
    {
      "name": "targets.setDefault",
      "args": {
        "targetId": "TargetId",
        "projectId": "ProjectId?",
        "locationId": "LocationId?",
        "language": "String?"
      },
      "returns": "Empty",
      "$comment": "§4bis.2a: all three NULL is the global default, the drawer's ANY row. A scope's default is its lowest sort_index; there is no is_default column"
    },
    {
      "name": "targets.upsert",
      "args": {
        "targetId": "TargetId?",
        "kind": "TargetKind",
        "name": "String",
        "execBytes": "Bytes",
        "argv": "[String]",
        "projectId": "ProjectId?",
        "locationId": "LocationId?",
        "language": "String?"
      },
      "returns": "TargetRow",
      "privileged": true,
      "$comment": "privileged: the executable originates from a shell-owned native dialog. argv is stored and spawned core-side, never through a shell"
    },
    {
      "name": "targets.verify",
      "args": { "targetId": "TargetId?" },
      "returns": "[TargetVerification]",
      "$comment": "§4bis.2a: per row and language-blind. Resolution never consults verify_state"
    },
    {
      "name": "art.url",
      "args": { "hash": "SceneHash", "rendition": "Rendition" },
      "returns": "String"
    },
    {
      "name": "art.rerender",
      "args": { "projectId": "ProjectId", "offset": "u32" },
      "returns": "ArtRerender",
      "$comment": "§7.4: the absolute target reroll_offset, never an increment, never more than 1 from the stored value, one project per call"
    },
    { "name": "identity.list", "args": {}, "returns": "[IdentityRow]" },
    {
      "name": "identity.confirm",
      "args": { "emails": "[String]", "apply": "bool" },
      "returns": "IdentityConfirm",
      "$comment": "§1.4: apply:false runs the join, returns the delta and writes nothing"
    },
    { "name": "stats.reveal", "args": {}, "returns": "Reveal" },
    { "name": "collections.list", "args": {}, "returns": "[Collection]" },
    {
      "name": "collections.upsert",
      "args": {
        "id": "CollectionId?",
        "name": "String",
        "kind": "CollectionKind",
        "queryText": "String?",
        "queryGrammarVersion": "u32",
        "sortIndex": "u32"
      },
      "returns": "CollectionUpsert"
    },
    {
      "name": "collections.remove",
      "args": { "id": "CollectionId" },
      "returns": "Empty",
      "$comment": "§8.8: deletes the collection and collection_member rows and touches nothing else"
    },
    {
      "name": "session.stop",
      "args": { "id": "SessionId" },
      "returns": "Empty",
      "idempotent": false
    },
    {
      "name": "session.focus",
      "args": { "projectId": "ProjectId?" },
      "returns": "Empty",
      "idempotent": true,
      "$comment": "§9: app focus extends a segment only while the focused view is that project, so the renderer must report which project's view holds focus; null means none. §2.4's table omits it. Not privileged — it originates no path and no executable"
    }

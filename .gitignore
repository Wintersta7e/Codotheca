# Working notes, plans, scratch and probes — never committed
.dev/

# Local project instructions — never committed
CLAUDE.md

# Raw brainstorm transcripts — name third-party projects, keep them out of history
idea*.txt

# build output
# The two .cjs hooks in build/ are committed; a staged binary never is.
build/worker/
target/
# The Windows-native build needs its own directory: WSL and Windows cargo both default to
# target/debug and each invalidates the other's artifacts, which surfaces as a rustc crash
# rather than a rebuild. Set CARGO_TARGET_DIR to this when building through interop.
target-win/
dist/
out/
node_modules/
*.tsbuildinfo

# generated protocol bindings — regenerated by `npm run gen`, never edited by hand
app/src/generated/
core/src/protocol.rs

# local
.env
*.log

# editor and tool state
.serena/
.vscode/
.idea/

# The corpus the CI step and a local `codotheca-corpus --out corpus-check` materialise.
corpus-check/

# Playwright's per-run artefacts.
test-results/
